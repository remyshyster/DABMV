// src/components/MatchCoordinator.tsx

import React, { useEffect, useState } from 'react';
import { createClient, SupabaseClient } from '@supabase/supabase-js';
import { BoardState, CombatEvent } from '../types/combat';
import { simulateCombat } from '../engine/simulateCombat';
import { BoardBuilder } from './BoardBuilder';
import { CombatVisualizer } from './CombatVisualizer';

const SUPABASE_URL = import.meta.env.VITE_SUPABASE_URL || 'https://your-project.supabase.co';
const SUPABASE_ANON_KEY = import.meta.env.VITE_SUPABASE_ANON_KEY || 'your-anon-key';

const supabase: SupabaseClient = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

interface MatchRow {
  id: string;
  status: 'waiting' | 'ready';
  board_a: BoardState;
  board_b: BoardState | null;
  seed: string;
}

export const MatchCoordinator: React.FC = () => {
  const [activeMatchId, setActiveMatchId] = useState<string | null>(null);
  const [matchStatus, setMatchStatus] = useState<'idle' | 'waiting' | 'ready'>('idle');
  const [combatLog, setCombatLog] = useState<CombatEvent[] | null>(null);
  const [initialBoards, setInitialBoards] = useState<{
    boardA: BoardState;
    boardB: BoardState;
  } | null>(null);

  // Listen to Postgres changes on public:matches
  useEffect(() => {
    if (!activeMatchId) return;

    const channel = supabase
      .channel('public:matches')
      .on(
        'postgres_changes',
        {
          event: 'UPDATE',
          schema: 'public',
          table: 'matches',
          filter: `id=eq.${activeMatchId}`,
        },
        (payload) => {
          const updatedMatch = payload.new as MatchRow;

          if (updatedMatch.status === 'ready' && updatedMatch.board_b) {
            setMatchStatus('ready');
            setInitialBoards({
              boardA: updatedMatch.board_a,
              boardB: updatedMatch.board_b,
            });

            // Deterministic Lockstep Execution:
            // Both clients execute identical math locally from the shared payload
            const events = simulateCombat(
              updatedMatch.board_a,
              updatedMatch.board_b,
              updatedMatch.seed
            );
            setCombatLog(events);
          }
        }
      )
      .subscribe();

    return () => {
      supabase.removeChannel(channel);
    };
  }, [activeMatchId]);

  const handleLockIn = async (myBoard: BoardState) => {
    setMatchStatus('waiting');

    // 1. Search for an existing match waiting for an opponent
    const { data: openMatch, error: fetchError } = await supabase
      .from('matches')
      .select('*')
      .eq('status', 'waiting')
      .order('created_at', { ascending: true })
      .limit(1)
      .maybeSingle<MatchRow>();

    if (fetchError) {
      console.error('Matchmaking query failed:', fetchError);
      setMatchStatus('idle');
      return;
    }

    // 2A. Found an open match -> Join as Player B and transition status to 'ready'
    if (openMatch) {
      setActiveMatchId(openMatch.id);

      const { data: updatedMatch, error: updateError } = await supabase
        .from('matches')
        .update({
          board_b: myBoard,
          status: 'ready',
        })
        .eq('id', openMatch.id)
        .select()
        .single<MatchRow>();

      if (updateError || !updatedMatch || !updatedMatch.board_b) {
        console.error('Failed to join match:', updateError);
        setMatchStatus('idle');
        return;
      }

      // Trigger simulation immediately for Player B as well
      setMatchStatus('ready');
      setInitialBoards({
        boardA: updatedMatch.board_a,
        boardB: updatedMatch.board_b,
      });

      const events = simulateCombat(
        updatedMatch.board_a,
        updatedMatch.board_b,
        updatedMatch.seed
      );
      setCombatLog(events);
      return;
    }

    // 2B. No open match found -> Create a new lobby as Player A
    const sharedSeed = crypto.randomUUID();
    const { data: createdMatch, error: insertError } = await supabase
      .from('matches')
      .insert({
        status: 'waiting',
        board_a: myBoard,
        seed: sharedSeed,
      })
      .select()
      .single<MatchRow>();

    if (insertError || !createdMatch) {
      console.error('Failed to create match:', insertError);
      setMatchStatus('idle');
      return;
    }

    setActiveMatchId(createdMatch.id);
  };

  return (
    <div style={{ padding: '2rem' }}>
      <h1>Deterministic Auto-Battler MVP</h1>

      {matchStatus !== 'ready' && (
        <BoardBuilder onLockIn={handleLockIn} disabled={matchStatus === 'waiting'} />
      )}

      {matchStatus === 'ready' && combatLog && initialBoards && (
        <CombatVisualizer
          events={combatLog}
          initialBoardA={initialBoards.boardA}
          initialBoardB={initialBoards.boardB}
        />
      )}
    </div>
  );
};
5. Phase 5: Visualizing the Log (src/components/CombatVisualizer.tsx)
In accordance with strict CQRS / Event-Sourcing principles, CombatVisualizer performs zero combat calculations. It does not subtract event.damage from unit.hp; instead, it directly overwrites the visual health state with event.remainingHp and deletes units upon receiving a 'death' event.
code
Tsx
// src/components/CombatVisualizer.tsx

import React, { useEffect, useState } from 'react';
import { BoardState, CombatEvent, PositionedUnit } from '../types/combat';

interface CombatVisualizerProps {
  events: CombatEvent[];
  initialBoardA: BoardState;
  initialBoardB: BoardState;
}

interface VisualUnit extends PositionedUnit {
  team: 'A' | 'B';
}

export const CombatVisualizer: React.FC<CombatVisualizerProps> = ({
  events,
  initialBoardA,
  initialBoardB,
}) => {
  // Hydrate initial visual state dictionary keyed by unit ID
  const [unitsById, setUnitsById] = useState<Record<string, VisualUnit>>(() => {
    const map: Record<string, VisualUnit> = {};
    initialBoardA.forEach((u) => {
      map[u.id] = { ...u, team: 'A' };
    });
    initialBoardB.forEach((u) => {
      map[u.id] = { ...u, y: u.y + 3, team: 'B' };
    });
    return map;
  });

  const [eventIndex, setEventIndex] = useState<number>(0);
  const [damagedUnitId, setDamagedUnitId] = useState<string | null>(null);
  const [attackerUnitId, setAttackerUnitId] = useState<string | null>(null);
  const [winnerLabel, setWinnerLabel] = useState<string | null>(null);

  useEffect(() => {
    if (eventIndex >= events.length) return;

    const timer = setTimeout(() => {
      const currentEvent = events[eventIndex];

      if (currentEvent.type === 'attack') {
        setAttackerUnitId(currentEvent.sourceId);
        setDamagedUnitId(currentEvent.targetId);

        // STRICT READ-ONLY STATE PROJECTION:
        // We do not compute (hp - damage); we directly apply remainingHp from the log.
        setUnitsById((prev) => {
          const target = prev[currentEvent.targetId];
          if (!target) return prev;
          return {
            ...prev,
            [currentEvent.targetId]: {
              ...target,
              hp: currentEvent.remainingHp,
            },
          };
        });
      } else if (currentEvent.type === 'death') {
        setDamagedUnitId(null);
        setAttackerUnitId(null);

        // Remove dead unit from the board
        setUnitsById((prev) => {
          const next = { ...prev };
          delete next[currentEvent.targetId];
          return next;
        });
      } else if (currentEvent.type === 'end') {
        setDamagedUnitId(null);
        setAttackerUnitId(null);
        setWinnerLabel(currentEvent.sourceId);
      }

      setEventIndex((prevIdx) => prevIdx + 1);
    }, 500);

    return () => clearTimeout(timer);
  }, [eventIndex, events]);

  const activeUnits = Object.values(unitsById);
  const currentEvent = events[Math.min(eventIndex, events.length - 1)];

  return (
    <div style={{ fontFamily: 'sans-serif', display: 'flex', gap: '2rem' }}>
      <div>
        <h2>Arena Playback (Step {eventIndex} / {events.length})</h2>
        {winnerLabel && (
          <div
            style={{
              padding: '0.75rem',
              marginBottom: '1rem',
              backgroundColor: '#fef08a',
              border: '2px solid #eab308',
              borderRadius: '6px',
              fontWeight: 'bold',
            }}
          >
            Combat Resolved — Winner: {winnerLabel}
          </div>
        )}

        {/* 3x6 Combined Arena Grid (Rows 0-2: Team A, Rows 3-5: Team B) */}
        <div
          style={{
            display: 'grid',
            gridTemplateColumns: 'repeat(3, 100px)',
            gridTemplateRows: 'repeat(6, 90px)',
            gap: '8px',
          }}
        >
          {Array.from({ length: 18 }).map((_, idx) => {
            const x = idx % 3;
            const y = Math.floor(idx / 3);
            const unit = activeUnits.find((u) => u.x === x && u.y === y);

            const isFlashingRed = unit && unit.id === damagedUnitId;
            const isAttacker = unit && unit.id === attackerUnitId;
            const healthPercent = unit ? (unit.hp / unit.maxHp) * 100 : 0;

            return (
              <div
                key={`${x}-${y}`}
                style={{
                  border: isAttacker
                    ? '3px solid #f59e0b'
                    : y < 3
                    ? '2px solid #3b82f6'
                    : '2px solid #a855f7',
                  borderRadius: '6px',
                  backgroundColor: isFlashingRed
                    ? '#ef4444' // Flash red on damage
                    : unit
                    ? unit.team === 'A'
                      ? '#eff6ff'
                      : '#faf5ff'
                    : '#f3f4f6',
                  color: isFlashingRed ? '#ffffff' : '#111827',
                  transition: 'background-color 0.15s ease',
                  display: 'flex',
                  flexDirection: 'column',
                  alignItems: 'center',
                  justifyContent: 'center',
                  padding: '6px',
                }}
              >
                {unit ? (
                  <>
                    <div style={{ fontSize: '0.75rem', fontWeight: 'bold' }}>
                      [{unit.team}] {unit.type}
                    </div>
                    <div style={{ fontSize: '0.7rem', marginBottom: '4px' }}>
                      {unit.hp} / {unit.maxHp} HP
                    </div>
                    {/* Health Bar */}
                    <div
                      style={{
                        width: '100%',
                        height: '8px',
                        backgroundColor: '#d1d5db',
                        borderRadius: '4px',
                        overflow: 'hidden',
                      }}
                    >
                      <div
                        style={{
                          width: `${healthPercent}%`,
                          height: '100%',
                          backgroundColor: '#22c55e',
                          transition: 'width 0.2s ease',
                        }}
                      />
                    </div>
                  </>
                ) : (
                  <span style={{ fontSize: '0.7rem', color: '#9ca3af' }}>
                    {y < 3 ? `A (${x},${y})` : `B (${x},${y - 3})`}
                  </span>
                )}
              </div>
            );
          })}
        </div>
      </div>

      {/* Deterministic Event Stream Inspector */}
      <div style={{ flex: 1 }}>
        <h3>Current Event Frame</h3>
        <pre
          style={{
            backgroundColor: '#1f2937',
            color: '#f9fafb',
            padding: '1rem',
            borderRadius: '6px',
            fontSize: '0.85rem',
          }}
        >
          {JSON.stringify(currentEvent, null, 2)}
        </pre>
      </div>
    </div>
  );
};