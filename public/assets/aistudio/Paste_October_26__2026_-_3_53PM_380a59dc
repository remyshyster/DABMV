// src/components/BoardBuilder.tsx

import React, { useState } from 'react';
import { BoardState, PositionedUnit, UnitType } from '../types/combat';

const UNIT_TEMPLATES: Record<UnitType, Omit<PositionedUnit, 'id' | 'x' | 'y'>> = {
  Knight: { type: 'Knight', hp: 100, maxHp: 100, attack: 25 },
  Archer: { type: 'Archer', hp: 60, maxHp: 60, attack: 40 },
};

interface BoardBuilderProps {
  onLockIn: (board: BoardState) => void;
  disabled?: boolean;
}

export const BoardBuilder: React.FC<BoardBuilderProps> = ({ onLockIn, disabled = false }) => {
  const [selectedUnitType, setSelectedUnitType] = useState<UnitType>('Knight');
  const [board, setBoard] = useState<BoardState>([]);

  const handleCellClick = (x: number, y: number) => {
    if (disabled) return;

    setBoard((prevBoard) => {
      const existingIndex = prevBoard.findIndex((u) => u.x === x && u.y === y);

      // Clicking an occupied cell removes the unit
      if (existingIndex !== -1) {
        return prevBoard.filter((_, idx) => idx !== existingIndex);
      }

      // Clicking an empty cell places the selected unit
      const template = UNIT_TEMPLATES[selectedUnitType];
      const newUnit: PositionedUnit = {
        id: crypto.randomUUID(),
        x,
        y,
        ...template,
      };

      return [...prevBoard, newUnit];
    });
  };

  return (
    <div style={{ display: 'flex', gap: '2rem', fontFamily: 'sans-serif', alignItems: 'flex-start' }}>
      <div>
        <h3>1. Select Unit Archetype</h3>
        <div style={{ display: 'flex', gap: '0.5rem', marginBottom: '1.5rem' }}>
          {(['Knight', 'Archer'] as UnitType[]).map((type) => (
            <button
              key={type}
              disabled={disabled}
              onClick={() => setSelectedUnitType(type)}
              style={{
                padding: '0.5rem 1rem',
                fontWeight: selectedUnitType === type ? 'bold' : 'normal',
                backgroundColor: selectedUnitType === type ? '#2563eb' : '#e5e7eb',
                color: selectedUnitType === type ? '#ffffff' : '#1f2937',
                border: 'none',
                borderRadius: '4px',
                cursor: 'pointer',
              }}
            >
              {type} (HP: {UNIT_TEMPLATES[type].hp} | ATK: {UNIT_TEMPLATES[type].attack})
            </button>
          ))}
        </div>

        <h3>2. Place on 3x3 Grid (Click to Add/Remove)</h3>
        <div
          style={{
            display: 'grid',
            gridTemplateColumns: 'repeat(3, 90px)',
            gridTemplateRows: 'repeat(3, 90px)',
            gap: '8px',
            marginBottom: '1.5rem',
          }}
        >
          {Array.from({ length: 9 }).map((_, idx) => {
            const x = idx % 3;
            const y = Math.floor(idx / 3);
            const occupant = board.find((u) => u.x === x && u.y === y);

            return (
              <div
                key={`${x}-${y}`}
                onClick={() => handleCellClick(x, y)}
                style={{
                  border: '2px solid #9ca3af',
                  borderRadius: '6px',
                  backgroundColor: occupant ? '#dbeafe' : '#f9fafb',
                  display: 'flex',
                  flexDirection: 'column',
                  alignItems: 'center',
                  justifyContent: 'center',
                  cursor: disabled ? 'not-allowed' : 'pointer',
                  userSelect: 'none',
                }}
              >
                {occupant ? (
                  <>
                    <strong>{occupant.type}</strong>
                    <span style={{ fontSize: '0.75rem', color: '#4b5563' }}>
                      HP: {occupant.hp}
                    </span>
                  </>
                ) : (
                  <span style={{ color: '#9ca3af', fontSize: '0.75rem' }}>
                    ({x}, {y})
                  </span>
                )}
              </div>
            );
          })}
        </div>

        <button
          onClick={() => onLockIn(board)}
          disabled={disabled || board.length === 0}
          style={{
            padding: '0.75rem 1.5rem',
            backgroundColor: board.length === 0 || disabled ? '#9ca3af' : '#16a34a',
            color: '#fff',
            border: 'none',
            borderRadius: '4px',
            fontWeight: 'bold',
            cursor: board.length === 0 || disabled ? 'not-allowed' : 'pointer',
          }}
        >
          {disabled ? 'Searching for Opponent...' : 'Lock In / Search for Match'}
        </button>
      </div>

      <div style={{ flex: 1 }}>
        <h3>Live BoardState JSON</h3>
        <pre
          style={{
            backgroundColor: '#111827',
            color: '#10b981',
            padding: '1rem',
            borderRadius: '6px',
            maxHeight: '360px',
            overflowY: 'auto',
            fontSize: '0.8rem',
          }}
        >
          {JSON.stringify(board, null, 2)}
        </pre>
      </div>
    </div>
  );
};
