As a Principal Systems Architect, I have designed this system around strict state-view separation (Event Sourcing / Lockstep Simulation).
To achieve guaranteed client-side determinism across different browsers and CPU architectures:
No non-deterministic APIs (Date.now(), Math.random(), or unsorted object key iterations) are permitted inside the simulation loop.
Coordinate Normalization: Since both players build on a local 3x3 grid (x: 0..2, y: 0..2), the engine projects boardB onto the opposite side of the arena (y + 3) before calculating Euclidean distances.
Read-Only Playback: The UI acts strictly as a dumb terminal projecting pre-computed state transitions from the CombatEvent[] tape.
Here is the complete implementation broken down into your five sequential modules.
1. Types & Seeded RNG (src/types/combat.ts)
Because Supabase stores the shared seed as a string, we combine a deterministic string hashing algorithm (FNV-1a) with Mulberry32 to produce a pure, repeatable pseudo-random number generator.
code
TypeScript
// src/types/combat.ts

export type UnitType = 'Knight' | 'Archer';

export interface Unit {
  id: string;
  type: UnitType;
  hp: number;
  maxHp: number;
  attack: number;
}

export interface PositionedUnit extends Unit {
  x: number;
  y: number;
}

export type BoardState = PositionedUnit[];

export type CombatEventType = 'attack' | 'death' | 'end';

export interface CombatEvent {
  type: CombatEventType;
  sourceId: string;
  targetId: string;
  damage: number;
  remainingHp: number;
}

/**
 * Converts an arbitrary string seed into a deterministic 32-bit unsigned integer
 * using the FNV-1a hash algorithm.
 */
function hashStringToUint32(str: string): number {
  let hash = 2166136261;
  for (let i = 0; i < str.length; i++) {
    hash ^= str.charCodeAt(i);
    hash = Math.imul(hash, 16777619);
  }
  return hash >>> 0;
}

/**
 * Mulberry32 Seeded PRNG.
 * Returns a deterministic function generating floats in [0, 1).
 */
export function createSeededRNG(seedString: string): () => number {
  let state = hashStringToUint32(seedString);

  return function nextFloat(): number {
    state += 0x6d2b79f5;
    let t = state;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
2. Phase 1: The Headless Engine (src/engine/simulateCombat.ts)
This module is pure TypeScript with zero external dependencies. It normalizes the two boards into a unified arena, uses the seeded PRNG for initiative shuffling and tie-breaking equidistant targets, and resolves the entire battle synchronously.
code
TypeScript
// src/engine/simulateCombat.ts

import { BoardState, CombatEvent, PositionedUnit, createSeededRNG } from '../types/combat';

interface InternalUnit extends PositionedUnit {
  team: 'A' | 'B';
}

/**
 * Deterministic Fisher-Yates shuffle using our seeded PRNG.
 */
function shuffleDeterministic<T>(array: T[], rng: () => number): T[] {
  const copy = [...array];
  for (let i = copy.length - 1; i > 0; i--) {
    const j = Math.floor(rng() * (i + 1));
    const temp = copy[i];
    copy[i] = copy[j];
    copy[j] = temp;
  }
  return copy;
}

/**
 * Squared Euclidean distance avoids floating-point square root drift across architectures.
 */
function getDistanceSquared(u1: InternalUnit, u2: InternalUnit): number {
  const dx = u1.x - u2.x;
  const dy = u1.y - u2.y;
  return dx * dx + dy * dy;
}

export function simulateCombat(
  boardA: BoardState,
  boardB: BoardState,
  seed: string
): CombatEvent[] {
  const rng = createSeededRNG(seed);
  const events: CombatEvent[] = [];

  // Deep clone and project coordinates into a shared 3x6 arena:
  // Board A occupies y: [0..2], Board B is offset to y: [3..5]
  const unitsA: InternalUnit[] = boardA.map((u) => ({
    ...u,
    team: 'A',
  }));

  const unitsB: InternalUnit[] = boardB.map((u) => ({
    ...u,
    y: u.y + 3,
    team: 'B',
  }));

  // Canonical sort by ID first to guarantee identical memory order before shuffling
  const roster: InternalUnit[] = [...unitsA, ...unitsB].sort((a, b) =>
    a.id.localeCompare(b.id)
  );

  let tickCount = 0;
  const MAX_TICKS = 1000; // Circuit breaker against infinite loops

  while (tickCount < MAX_TICKS) {
    tickCount++;

    const livingA = roster.filter((u) => u.team === 'A' && u.hp > 0);
    const livingB = roster.filter((u) => u.team === 'B' && u.hp > 0);

    // Check termination conditions
    if (livingA.length === 0 || livingB.length === 0) {
      const winnerTeam = livingA.length > 0 ? 'TEAM_A' : livingB.length > 0 ? 'TEAM_B' : 'DRAW';
      events.push({
        type: 'end',
        sourceId: winnerTeam,
        targetId: 'NONE',
        damage: 0,
        remainingHp: 0,
      });
      break;
    }

    // Deterministically shuffle turn order for the current combat round
    const activeTurnOrder = shuffleDeterministic(
      roster.filter((u) => u.hp > 0),
      rng
    );

    for (const attacker of activeTurnOrder) {
      // A unit may have died earlier in this same tick
      if (attacker.hp <= 0) continue;

      const livingEnemies = roster.filter(
        (u) => u.team !== attacker.team && u.hp > 0
      );

      if (livingEnemies.length === 0) break;

      // Find closest enemy (or enemies if equidistant)
      let minDistanceSq = Infinity;
      let closestCandidates: InternalUnit[] = [];

      for (const enemy of livingEnemies) {
        const distSq = getDistanceSquared(attacker, enemy);
        if (distSq < minDistanceSq) {
          minDistanceSq = distSq;
          closestCandidates = [enemy];
        } else if (distSq === minDistanceSq) {
          closestCandidates.push(enemy);
        }
      }

      // Break ties deterministically using seeded RNG
      const targetIndex = Math.floor(rng() * closestCandidates.length);
      const target = closestCandidates[targetIndex];

      // Resolve Attack
      const damage = attacker.attack;
      target.hp = Math.max(0, target.hp - damage);

      events.push({
        type: 'attack',
        sourceId: attacker.id,
        targetId: target.id,
        damage,
        remainingHp: target.hp,
      });

      // Resolve Death
      if (target.hp === 0) {
        events.push({
          type: 'death',
          sourceId: attacker.id,
          targetId: target.id,
          damage: 0,
          remainingHp: 0,
        });
      }
    }
  }

  return events;
}
